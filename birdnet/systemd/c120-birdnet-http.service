[Unit]
Description=Serve C120 HLS audio to BirdNET
After=network.target

[Service]
Type=simple
User=braydenchaffee
WorkingDirectory=/home/braydenchaffee/birdnet-download/hls
ExecStart=/usr/bin/python3 -m http.server 8765 --bind 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
